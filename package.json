{
  "name": "sonar",
  "version": "1.0.0",
  "description": "Offline text-to-speech application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test:tts:voices": "node tools/tts/test-tts.js voices",
    "test:tts:speak": "node tools/tts/test-tts.js speak",
    "test:tts:limit": "node tools/tts/test-tts.js limit-test",
    "test:license": "node tools/license/test-license.js",
    "license:check": "node tools/license/license-cli.js check",
    "license:activate": "node tools/license/license-cli.js activate",
    "license:deactivate": "node tools/license/license-cli.js deactivate",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "pdfjs-dist": "^6.3.289"
  },
  "build": {
    "appId": "com.yourcompany.sonar",
    "productName": "Sonar",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/kokoro-js/**/*",
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/sharp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}